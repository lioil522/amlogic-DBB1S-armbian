			eth-phy-mux@55c {
				compatible = "mdio-mux-mmioreg", "mdio-mux";
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				reg = <0x0 0x55c 0x0 0x4>;
				mux-mask = <0xffffffff>;
				mdio-parent-bus = <&mdio0>;

				internal_mdio: mdio@e40908ff {
					reg = <0xe40908ff>;
					#address-cells = <0x1>;
					#size-cells = <0x0>;

					internal_phy: ethernet-phy@8 {
						compatible = "ethernet-phy-id0181.4400";
						interrupts = <0x0 0x9 0x4>;
						reg = <0x8>;
						max-speed = <0x64>;
					};
				};

				external_mdio: mdio@2009087f {
					reg = <0x2009087f>;
					#address-cells = <0x1>;
					#size-cells = <0x0>;
				};
			};
		};

		dmcbus: bus@c8838000 {
			compatible = "simple-bus";
			reg = <0x0 0xc8838000 0x0 0x400>;
			#address-cells = <0x2>;
			#size-cells = <0x2>;
			ranges = <0x0 0x0 0x0 0xc8838000 0x0 0x400>;

			canvas: video-lut@48 {
				compatible = "amlogic,canvas";
				reg = <0x0 0x48 0x0 0x14>;
			};
		};

		hiubus: bus@c883c000 {
			compatible = "simple-bus";
			reg = <0x0 0xc883c000 0x0 0x2000>;
			#address-cells = <0x2>;
			#size-cells = <0x2>;
			ranges = <0x0 0x0 0x0 0xc883c000 0x0 0x2000>;

			sysctrl: system-controller@0 {
				compatible = "amlogic,meson-gx-hhi-sysctrl", "simple-mfd", "syscon";
				reg = <0x0 0x0 0x0 0x400>;

				pwrc: power-controller {
					compatible = "amlogic,meson-gxbb-pwrc";
					#power-domain-cells = <0x1>;
					amlogic,ao-sysctrl = <&sysctrl_AO>;
					resets = <&reset 0x5 &reset 0xa &reset 0xd &reset 0x25 &reset 0x84 &reset 0x85 &reset 0x86 &reset 0x87 &reset 0x89 &reset 0x8c &reset 0x8d &reset 0xe7>;
					reset-names = "viu", "venc", "vcbus", "bt656", "dvin", "rdma", "venci", "vencp", "vdac", "vdi6", "vencl", "vid_lock";
					clocks = <&clkc 0x84 &clkc 0x8c>;
					clock-names = "vpu", "vapb";
					assigned-clocks = <&clkc 0x7e &clkc 0x80 &clkc 0x84 &clkc 0x85 &clkc 0x87 &clkc 0x8b>;
					assigned-clock-parents = <&clkc 0x5 0x0 &clkc 0x80 &clkc 0x6 0x0 &clkc 0x87>;
					assigned-clock-rates = <0x0 0x27bc86aa 0x0 0x0 0xee6b280 0x0>;
				};

				clkc: clock-controller {
					compatible = "amlogic,gxl-clkc";
					#clock-cells = <0x1>;
					clocks = <&xtal>;
					clock-names = "xtal";
				};
			};

			mailbox: mailbox@404 {
				compatible = "amlogic,meson-gxbb-mhu";
				reg = <0x0 0x404 0x0 0x4c>;
				interrupts = <0x0 0xd0 0x1 0x0 0xd1 0x1 0x0 0xd2 0x1>;
				#mbox-cells = <0x1>;
			};
		};

		ethmac: ethernet@c9410000 {
			compatible = "amlogic,meson-gxbb-dwmac", "snps,dwmac-3.70a", "snps,dwmac";
			reg = <0x0 0xc9410000 0x0 0x10000 0x0 0xc8834540 0x0 0x4>;
			interrupts = <0x0 0x8 0x4>;
			interrupt-names = "macirq";
			rx-fifo-depth = <0x1000>;
			tx-fifo-depth = <0x800>;
			power-domains = <&pwrc 0x1>;
			status = "okay";
			clocks = <&clkc 0x24 &clkc 0x4 &clkc 0xf &clkc 0x4>;
			clock-names = "stmmaceth", "clkin0", "clkin1", "timing-adjustment";
			phy-mode = "rmii";
			phy-handle = <&internal_phy>;

			mdio0: mdio {
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				compatible = "snps,dwmac-mdio";
			};
		};

		apb: apb@d0000000 {
			compatible = "simple-bus";
			reg = <0x0 0xd0000000 0x0 0x200000>;
			#address-cells = <0x2>;
			#size-cells = <0x2>;
			ranges = <0x0 0x0 0x0 0xd0000000 0x0 0x200000>;

			sd_emmc_a: mmc@70000 {
				compatible = "amlogic,meson-gx-mmc", "amlogic,meson-gxbb-mmc";
				reg = <0x0 0x70000 0x0 0x800>;
				interrupts = <0x0 0xd8 0x4>;
				status = "okay";
				clocks = <&clkc 0x5e &clkc 0x77 &clkc 0x4>;
				clock-names = "core", "clkin0", "clkin1";
				resets = <&reset 0x2c>;
				pinctrl-0 = <&sdio_pins>;
				pinctrl-1 = <&sdio_clk_gate_pins>;
				pinctrl-names = "default", "clk-gate";
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				bus-width = <0x4>;
				cap-sd-highspeed;
				sd-uhs-sdr12;
				sd-uhs-sdr25;
				sd-uhs-sdr50;
				sd-uhs-sdr104;
				cap-sdio-irq;
				max-frequency = <0xbebc200>;
				non-removable;
				disable-wp;
				keep-power-in-suspend;
				mmc-pwrseq = <&sdio_pwrseq>;
				vmmc-supply = <&vddao_3v3>;
				vqmmc-supply = <&vddio_boot>;

				brcmf: wifi@1 {
					reg = <0x1>;
					compatible = "brcm,bcm4329-fmac";
				};
			};

			sd_emmc_b: mmc@72000 {
				compatible = "amlogic,meson-gx-mmc", "amlogic,meson-gxbb-mmc";
				reg = <0x0 0x72000 0x0 0x800>;
				interrupts = <0x0 0xd9 0x4>;
				status = "okay";
				clocks = <&clkc 0x5f &clkc 0x7a &clkc 0x4>;
				clock-names = "core", "clkin0", "clkin1";
				resets = <&reset 0x2d>;
				assigned-clocks = <&clkc 0x7a>;
				assigned-clock-rates = <0x16e3600>;
				pinctrl-0 = <&sdcard_pins>;
				pinctrl-1 = <&sdcard_clk_gate_pins>;
				pinctrl-names = "default", "clk-gate";
				bus-width = <0x4>;
				cap-sd-highspeed;
				max-frequency = <0x5f5e100>;
				disable-wp;
				cd-gpios = <&gpio 0x30 0x1>;
				vmmc-supply = <&vddao_3v3>;
				vqmmc-supply = <&vddio_boot>;
			};

			sd_emmc_c: mmc@74000 {
				compatible = "amlogic,meson-gx-mmc", "amlogic,meson-gxbb-mmc";
				reg = <0x0 0x74000 0x0 0x800>;
				interrupts = <0x0 0xda 0x4>;
				status = "okay";
				clocks = <&clkc 0x60 &clkc 0x7d &clkc 0x4>;
				clock-names = "core", "clkin0", "clkin1";
				resets = <&reset 0x2e>;
				assigned-clocks = <&clkc 0x7d>;
				assigned-clock-rates = <0x16e3600>;
				pinctrl-0 = <&emmc_pins &emmc_ds_pins>;
				pinctrl-1 = <&emmc_clk_gate_pins>;
				pinctrl-names = "default", "clk-gate";
				bus-width = <0x8>;
				cap-mmc-highspeed;
				max-frequency = <0xbebc200>;
				non-removable;
				disable-wp;
				mmc-ddr-1_8v;
				mmc-hs200-1_8v;
				mmc-hs400-1_8v;
				mmc-pwrseq = <&emmc_pwrseq>;
				vmmc-supply = <&vcc_3v3>;
				vqmmc-supply = <&vddio_boot>;
			};

			usb2_phy0: phy@78000 {
				compatible = "amlogic,meson-gxl-usb2-phy";
				#phy-cells = <0x0>;
				reg = <0x0 0x78000 0x0 0x20>;
				clocks = <&clkc 0x37>;
				clock-names = "phy";
				resets = <&reset 0x22>;
				reset-names = "phy";
				status = "okay";
				phy-supply = <&b1s_ref_b2>;
			};

			usb2_phy1: phy@78020 {
				compatible = "amlogic,meson-gxl-usb2-phy";
				#phy-cells = <0x0>;
				reg = <0x0 0x78020 0x0 0x20>;
				clocks = <&clkc 0x37>;
				clock-names = "phy";
				resets = <&reset 0x22>;
				reset-names = "phy";
				status = "okay";
				phy-supply = <&b1s_ref_b2>;
			};

			usb2_phy2: phy@78040 {
				compatible = "amlogic,meson-gxl-usb2-phy";
				#phy-cells = <0x0>;
				reg = <0x0 0x78040 0x0 0x20>;
				clocks = <&clkc 0x37>;
				clock-names = "phy";
				resets = <&reset 0x22>;
				reset-names = "phy";
				status = "okay";
				phy-supply = <&b1s_ref_b2>;
			};

			mali: gpu@c0000 {
				compatible = "amlogic,meson-gxm-mali", "arm,mali-t820";
				reg = <0x0 0xc0000 0x0 0x40000>;
				interrupt-parent = <&gic>;
				interrupts = <0x0 0xa2 0x4 0x0 0xa1 0x4 0x0 0xa0 0x4>;
				interrupt-names = "job", "mmu", "gpu";
				clocks = <&clkc 0x6a>;
				resets = <&reset 0x14 &reset 0x4e>;
				operating-points-v2 = <&gpu_opp_table>;
			};
		};

		vpu: vpu@d0100000 {
			compatible = "amlogic,meson-gxm-vpu", "amlogic,meson-gx-vpu";
			reg = <0x0 0xd0100000 0x0 0x100000 0x0 0xc883c000 0x0 0x1000>;
			reg-names = "vpu", "hhi";
			interrupts = <0x0 0x3 0x1>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			amlogic,canvas = <&canvas>;
			power-domains = <&pwrc 0x0>;

			cvbs_vdac_port: port@0 {
				reg = <0x0>;

				cvbs_vdac_out: endpoint {
					remote-endpoint = <&cvbs_connector_in>;
				};
			};

			hdmi_tx_port: port@1 {
				reg = <0x1>;

				hdmi_tx_out: endpoint {
					remote-endpoint = <&hdmi_tx_in>;
				};
			};
		};

		hdmi_tx: hdmi-tx@c883a000 {
			compatible = "amlogic,meson-gxm-dw-hdmi", "amlogic,meson-gx-dw-hdmi";
			reg = <0x0 0xc883a000 0x0 0x1c>;
			interrupts = <0x0 0x39 0x1>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			#sound-dai-cells = <0x0>;
			sound-name-prefix = "HDMITX";
			status = "okay";
			resets = <&reset 0x13 &reset 0x4f &reset 0x42>;
			reset-names = "hdmitx_apb", "hdmitx", "hdmitx_phy";
			clocks = <&clkc 0x3f &clkc 0xc &clkc 0x4d>;
			clock-names = "isfr", "iahb", "venci";
			power-domains = <&pwrc 0x0>;
			assigned-clocks = <&clkc 0xcb &clkc 0xcd>;
			assigned-clock-parents = <&xtal 0x0>;
			assigned-clock-rates = <0x0 0x16e3600>;
			pinctrl-0 = <&hdmi_hpd_pins &hdmi_i2c_pins>;
			pinctrl-names = "default";
			hdmi-supply = <&hdmi_5v>;

			hdmi_tx_venc_port: port@0 {
				reg = <0x0>;

				hdmi_tx_in: endpoint {
					remote-endpoint = <&hdmi_tx_out>;
				};
			};

			hdmi_tx_tmds_port: port@1 {
				reg = <0x1>;

				hdmi_tx_tmds_out: endpoint {
					remote-endpoint = <&hdmi_connector_in>;
				};
			};
		};

		usb: usb@d0078080 {
			compatible = "amlogic,meson-gxm-usb-ctrl";
			reg = <0x0 0xd0078080 0x0 0x20>;
			interrupts = <0x0 0x10 0x4>;
			#address-cells = <0x2>;
			#size-cells = <0x2>;
			ranges;
			clocks = <&clkc 0x37 &clkc 0x40>;
			clock-names = "usb_ctrl", "ddr";
			resets = <&reset 0x22>;
			dr_mode = "otg";
			phys = <&usb2_phy0 &usb2_phy1 &usb2_phy2>;
			phy-names = "usb2-phy0", "usb2-phy1", "usb2-phy2";
			status = "okay";

			dwc2: usb@c9100000 {
				compatible = "amlogic,meson-g12a-usb", "snps,dwc2";
				reg = <0x0 0xc9100000 0x0 0x40000>;
				interrupts = <0x0 0x1f 0x4>;
				clocks = <&clkc 0x33>;
				clock-names = "otg";
				phys = <&usb2_phy1>;
				dr_mode = "peripheral";
				g-rx-fifo-size = <0xc0>;
				g-np-tx-fifo-size = <0x80>;
				g-tx-fifo-size = <0x80 0x80 0x10 0x10 0x10>;
			};

			dwc3: usb@c9000000 {
				compatible = "snps,dwc3";
				reg = <0x0 0xc9000000 0x0 0x100000>;
				interrupts = <0x0 0x1e 0x4>;
				dr_mode = "host";
				maximum-speed = "high-speed";
				snps,dis_u2_susphy_quirk;
			};
		};

		acodec: audio-controller@c8832000 {
			compatible = "amlogic,t9015";
			reg = <0x0 0xc8832000 0x0 0x14>;
			#sound-dai-cells = <0x0>;
			sound-name-prefix = "ACODEC";
			clocks = <&clkc 0xce>;
			clock-names = "pclk";
			resets = <&reset 0x3d>;
			status = "okay";
			AVDD-supply = <&vddio_ao18>;
		};

		crypto: crypto@c883e000 {
			compatible = "amlogic,gxl-crypto";
			reg = <0x0 0xc883e000 0x0 0x36>;
			interrupts = <0x0 0xbc 0x1 0x0 0xbd 0x1>;
			clocks = <&clkc 0x2e>;
			clock-names = "blkmv";
			status = "okay";
		};
	};

	gpu_opp_table: opp-table {
		compatible = "operating-points-v2";

		opp-125000000 {
			opp-hz = <0x0 0x7735940>;
			opp-microvolt = <0xe7ef0>;
		};

		opp-250000000 {
			opp-hz = <0x0 0xee6b280>;
			opp-microvolt = <0xe7ef0>;
		};

		opp-285714285 {
			opp-hz = <0x0 0x1107a76d>;
			opp-microvolt = <0xe7ef0>;
		};

		opp-400000000 {
			opp-hz = <0x0 0x17d78400>;
			opp-microvolt = <0xe7ef0>;
		};

		opp-500000000 {
			opp-hz = <0x0 0x1dcd6500>;
			opp-microvolt = <0xe7ef0>;
		};

		opp-666666666 {
			opp-hz = <0x0 0x27bc86aa>;
			opp-microvolt = <0xe7ef0>;
		};
	};

	dio2133: analog-amplifier {
		compatible = "simple-audio-amplifier";
		sound-name-prefix = "AU2";
		VCC-supply = <&hdmi_5v>;
		enable-gpios = <&gpio 0x15 0x0>;
	};

	spdif_dit: audio-codec-0 {
		#sound-dai-cells = <0x0>;
		compatible = "linux,spdif-dit";
		status = "okay";
		sound-name-prefix = "DIT";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0xc0000000>;
	};

	hdmi_5v: regulator-hdmi-5v {
		compatible = "regulator-fixed";
		regulator-name = "HDMI_5V";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		gpio = <&gpio 0x13 0x0>;
		enable-active-high;
		regulator-always-on;
	};

	vddio_ao18: regulator-vddio_ao18 {
		compatible = "regulator-fixed";
		regulator-name = "VDDIO_AO18";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
	};

	vddio_boot: regulator-vddio_boot {
		compatible = "regulator-fixed";
		regulator-name = "VDDIO_BOOT";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
	};

	vddao_3v3: regulator-vddao_3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VDDAO_3V3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
	};

	vcc_3v3: regulator-vcc_3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VCC_3V3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
	};

	emmc_pwrseq: emmc-pwrseq {
		compatible = "mmc-pwrseq-emmc";
		reset-gpios = <&gpio 0x23 0x1>;
	};

	wifi32k: wifi32k {
		compatible = "pwm-clock";
		#clock-cells = <0x0>;
		clock-frequency = <0x8000>;
		pwms = <&pwm_ef 0x0 0x7736 0x0>;
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpio 0x55 0x1>;
		clocks = <&wifi32k>;
		clock-names = "ext_clock";
	};

	cvbs-connector {
		compatible = "composite-video-connector";

		port {

			cvbs_connector_in: endpoint {
				remote-endpoint = <&cvbs_vdac_out>;
			};
		};
	};

	hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";

		port {

			hdmi_connector_in: endpoint {
				remote-endpoint = <&hdmi_tx_tmds_out>;
			};
		};
	};

	sound {
		compatible = "amlogic,gx-sound-card";
		model = "P230-Q200";
		audio-aux-devs = <&dio2133>;
		audio-widgets = "Line", "Lineout";
		audio-routing = "AU2 INL", "ACODEC LOLP", "AU2 INR", "ACODEC LORP", "AU2 INL", "ACODEC LOLN", "AU2 INR", "ACODEC LORN", "Lineout", "AU2 OUTL", "Lineout", "AU2 OUTR";
		assigned-clocks = <&clkc 0xd &clkc 0xe &clkc 0xf>;
		assigned-clock-parents = <0x0 0x0 0x0>;
		assigned-clock-rates = <0x11940000 0x10266000 0x17700000>;
		status = "okay";

		dai-link-0 {
			sound-dai = <&aiu 0x0 0x0>;
		};

		dai-link-1 {
			sound-dai = <&aiu 0x0 0x1>;
		};

		dai-link-2 {
			sound-dai = <&aiu 0x0 0x2>;
			dai-format = "i2s";
			mclk-fs = <0x100>;

			codec-0 {
				sound-dai = <&aiu 0x1 0x0>;
			};

			codec-1 {
				sound-dai = <&aiu 0x2 0x0>;
			};
		};

		dai-link-3 {
			sound-dai = <&aiu 0x0 0x3>;

			codec-0 {
				sound-dai = <&spdif_dit>;
			};
		};

		dai-link-4 {
			sound-dai = <&aiu 0x1 0x2>;

			codec-0 {
				sound-dai = <&hdmi_tx>;
			};
		};

		dai-link-5 {
			sound-dai = <&aiu 0x2 0x2>;

			codec-0 {
				sound-dai = <&acodec>;
			};
		};
	};

	leds {
		compatible = "gpio-leds";

		led-sys {
			label = "sys_led";
			gpios = <&gpio 0x9 0x1>;
			linux,default-trigger = "heartbeat";
			default-state = "off";
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-power {
			label = "power";
			linux,code = <0x74>;
			gpios = <&gpio_ao 0x2 0x1>;
		};
	};

	b1s_ref_b2: regulator-vcc-5v {
		compatible = "regulator-fixed";
		regulator-name = "VCC_5V";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		regulator-always-on;
	};

	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 0x0>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <0x1a17b0>;

		button-reset {
			label = "Reset";
			linux,code = <0x9b>;
			press-threshold-microvolt = <0x2710>;
		};

		button-vol-down {
			label = "Volume Down";
			linux,code = <0x72>;
			press-threshold-microvolt = <0x22e98>;
		};

		button-vol-up {
			label = "Volume Up";
			linux,code = <0x73>;
			press-threshold-microvolt = <0x42680>;
		};

		button-esc {
			label = "Escape";
			linux,code = <0x1>;
			press-threshold-microvolt = <0x64190>;
		};

		button-home {
			label = "Home";
			linux,code = <0x66>;
			press-threshold-microvolt = <0x84530>;
		};
	};
};
