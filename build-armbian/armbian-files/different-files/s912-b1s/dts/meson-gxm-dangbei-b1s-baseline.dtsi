// SPDX-License-Identifier: GPL-2.0-only
// Recovered from the known-bootable B1S DTB; see ../README.md for provenance.
// Baseline SHA256: 7a8e99758a54d22c670737d5226058f37056b360d4ea29f556cda19eda7280a0

/ {
	interrupt-parent = <&gic>;
	#address-cells = <0x2>;
	#size-cells = <0x2>;
	compatible = "dangbei,b1s", "amlogic,s912", "amlogic,meson-gxm";
	model = "Dangbei B1S";

	aliases {
		mmc0 = "/soc/apb@d0000000/mmc@70000";
		mmc1 = "/soc/apb@d0000000/mmc@72000";
		mmc2 = "/soc/apb@d0000000/mmc@74000";
		serial0 = "/soc/bus@c8100000/serial@4c0";
		ethernet0 = "/soc/ethernet@c9410000";
	};

	reserved-memory {
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;

		hwrom_reserved: hwrom@0 {
			reg = <0x0 0x0 0x0 0x1000000>;
			no-map;
		};

		secmon_reserved: secmon@10000000 {
			reg = <0x0 0x10000000 0x0 0x200000>;
			no-map;
		};

		secmon_reserved_alt: secmon@5000000 {
			reg = <0x0 0x5000000 0x0 0x300000>;
			no-map;
		};

		secmon_reserved_bl32: secmon@5300000 {
			reg = <0x0 0x5300000 0x0 0x2000000>;
			no-map;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x0 0x10000000>;
			alignment = "", "", "", "", "", "@", "";
			linux,cma-default;
		};
	};

	chosen {
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;
		stdout-path = "serial0:115200n8";

		simplefb_cvbs: framebuffer-cvbs {
			compatible = "amlogic,simple-framebuffer", "simple-framebuffer";
			amlogic,pipeline = "vpu-cvbs";
			power-domains = <&pwrc 0x0>;
			status = "disabled";
		};

		simplefb_hdmi: framebuffer-hdmi {
			compatible = "amlogic,simple-framebuffer", "simple-framebuffer";
			amlogic,pipeline = "vpu-hdmi";
			power-domains = <&pwrc 0x0>;
			status = "disabled";
			clocks = <&clkc 0x3f &clkc 0xc &clkc 0x4d>;
		};
	};

	cpus {
		#address-cells = <0x2>;
		#size-cells = <0x0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0 0x0>;
			enable-method = "psci";
			d-cache-line-size = <0x20>;
			d-cache-size = <0x8000>;
			d-cache-sets = <0x20>;
			i-cache-line-size = <0x20>;
			i-cache-size = <0x8000>;
			i-cache-sets = <0x20>;
			next-level-cache = <&l2>;
			clocks = <&scpi_dvfs 0x0>;
			#cooling-cells = <0x2>;
			capacity-dmips-mhz = <0x400>;
		};

		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0 0x1>;
			enable-method = "psci";
			d-cache-line-size = <0x20>;
			d-cache-size = <0x8000>;
			d-cache-sets = <0x20>;
			i-cache-line-size = <0x20>;
			i-cache-size = <0x8000>;
			i-cache-sets = <0x20>;
			next-level-cache = <&l2>;
			clocks = <&scpi_dvfs 0x0>;
			#cooling-cells = <0x2>;
			capacity-dmips-mhz = <0x400>;
		};

		cpu2: cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0 0x2>;
			enable-method = "psci";
			d-cache-line-size = <0x20>;
			d-cache-size = <0x8000>;
			d-cache-sets = <0x20>;
			i-cache-line-size = <0x20>;
			i-cache-size = <0x8000>;
			i-cache-sets = <0x20>;
			next-level-cache = <&l2>;
			clocks = <&scpi_dvfs 0x0>;
			#cooling-cells = <0x2>;
			capacity-dmips-mhz = <0x400>;
		};

		cpu3: cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0 0x3>;
			enable-method = "psci";
			d-cache-line-size = <0x20>;
			d-cache-size = <0x8000>;
			d-cache-sets = <0x20>;
			i-cache-line-size = <0x20>;
			i-cache-size = <0x8000>;
			i-cache-sets = <0x20>;
			next-level-cache = <&l2>;
			clocks = <&scpi_dvfs 0x0>;
			#cooling-cells = <0x2>;
			capacity-dmips-mhz = <0x400>;
		};

		l2: l2-cache0 {
			compatible = "cache";
			cache-level = <0x2>;
			cache-unified;
			cache-size = <0x80000>;
			cache-line-size = <0x40>;
			cache-sets = <0x200>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <&cpu0>;
				};

				core1 {
					cpu = <&cpu1>;
				};

				core2 {
					cpu = <&cpu2>;
				};

				core3 {
					cpu = <&cpu3>;
				};
			};

			cluster1 {

				core0 {
					cpu = <&cpu4>;
				};

				core1 {
					cpu = <&cpu5>;
				};

				core2 {
					cpu = <&cpu6>;
				};

				core3 {
					cpu = <&cpu7>;
				};
			};
		};

		cpu4: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0 0x100>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			d-cache-line-size = <0x20>;
			d-cache-size = <0x8000>;
			d-cache-sets = <0x20>;
			i-cache-line-size = <0x20>;
			i-cache-size = <0x8000>;
			i-cache-sets = <0x20>;
			next-level-cache = <&l2>;
			clocks = <&scpi_dvfs 0x1>;
			#cooling-cells = <0x2>;
		};

		cpu5: cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0 0x101>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			d-cache-line-size = <0x20>;
			d-cache-size = <0x8000>;
			d-cache-sets = <0x20>;
			i-cache-line-size = <0x20>;
			i-cache-size = <0x8000>;
			i-cache-sets = <0x20>;
			next-level-cache = <&l2>;
			clocks = <&scpi_dvfs 0x1>;
			#cooling-cells = <0x2>;
		};

		cpu6: cpu@102 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0 0x102>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			d-cache-line-size = <0x20>;
			d-cache-size = <0x8000>;
			d-cache-sets = <0x20>;
			i-cache-line-size = <0x20>;
			i-cache-size = <0x8000>;
			i-cache-sets = <0x20>;
			next-level-cache = <&l2>;
			clocks = <&scpi_dvfs 0x1>;
			#cooling-cells = <0x2>;
		};

		cpu7: cpu@103 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0 0x103>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			d-cache-line-size = <0x20>;
			d-cache-size = <0x8000>;
			d-cache-sets = <0x20>;
			i-cache-line-size = <0x20>;
			i-cache-size = <0x8000>;
			i-cache-sets = <0x20>;
			next-level-cache = <&l2>;
			clocks = <&scpi_dvfs 0x1>;
			#cooling-cells = <0x2>;
		};
	};

	thermal-zones {

		cpu-thermal {
			polling-delay-passive = <0x320>;
			polling-delay = <0x7d0>;
			thermal-sensors = <&scpi_sensors 0x0>;

			trips {

				cpu_passive: cpu-passive {
					temperature = <0x13880>;
					hysteresis = <0x7d0>;
					type = "passive";
				};

				cpu_hot: cpu-hot {
					temperature = <0x15f90>;
					hysteresis = <0x7d0>;
					type = "hot";
				};

				cpu_critical: cpu-critical {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cpu_cooling_maps: cooling-maps {

				map0 {
					trip = <&cpu_passive>;
					cooling-device = <&cpu0 0xffffffff 0xffffffff &cpu1 0xffffffff 0xffffffff &cpu2 0xffffffff 0xffffffff &cpu3 0xffffffff 0xffffffff &cpu4 0xffffffff 0xffffffff &cpu5 0xffffffff 0xffffffff &cpu6 0xffffffff 0xffffffff &cpu7 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <&cpu_hot>;
					cooling-device = <&cpu0 0xffffffff 0xffffffff &cpu1 0xffffffff 0xffffffff &cpu2 0xffffffff 0xffffffff &cpu3 0xffffffff 0xffffffff &cpu4 0xffffffff 0xffffffff &cpu5 0xffffffff 0xffffffff &cpu6 0xffffffff 0xffffffff &cpu7 0xffffffff 0xffffffff>;
				};
			};
		};
	};

	arm-pmu {
		compatible = "arm,cortex-a53-pmu";
		interrupts = <0x0 0x89 0x4 0x0 0x8a 0x4 0x0 0x99 0x4 0x0 0x9a 0x4>;
		interrupt-affinity = <&cpu0 &cpu1 &cpu2 &cpu3>;
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x1 0xd 0xff08 0x1 0xe 0xff08 0x1 0xb 0xff08 0x1 0xa 0xff08>;
	};

	xtal: xtal-clk {
		compatible = "fixed-clock";
		clock-frequency = <0x16e3600>;
		clock-output-names = "xtal";
		#clock-cells = <0x0>;
	};

	firmware {

		sm: secure-monitor {
			compatible = "amlogic,meson-gx-sm", "amlogic,meson-gxbb-sm";
		};
	};

	system-suspend {
		compatible = "amlogic,meson-gx-pm";
	};

	efuse: efuse {
		compatible = "amlogic,meson-gx-efuse", "amlogic,meson-gxbb-efuse";
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		read-only;
		secure-monitor = <&sm>;
		clocks = <&clkc 0x3a>;

		sn: sn@14 {
			reg = <0x14 0x10>;
		};

		eth_mac: eth-mac@34 {
			reg = <0x34 0x10>;
		};

		bid: bid@46 {
			reg = <0x46 0x30>;
		};
	};

	scpi {
		compatible = "amlogic,meson-gxbb-scpi", "arm,scpi-pre-1.0";
		mboxes = <&mailbox 0x1 &mailbox 0x2>;
		shmem = <&cpu_scp_lpri &cpu_scp_hpri>;

		scpi_clocks: clocks {
			compatible = "arm,scpi-clocks";

			scpi_dvfs: clocks-0 {
				compatible = "arm,scpi-dvfs-clocks";
				#clock-cells = <0x1>;
				clock-indices = <0x0 0x1>;
				clock-output-names = "vbig", "vlittle";
			};
		};

		scpi_sensors: sensors {
			compatible = "amlogic,meson-gxbb-scpi-sensors", "arm,scpi-sensors";
			#thermal-sensor-cells = <0x1>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;

		cbus: bus@c1100000 {
			compatible = "simple-bus";
			reg = <0x0 0xc1100000 0x0 0x100000>;
			#address-cells = <0x2>;
			#size-cells = <0x2>;
			ranges = <0x0 0x0 0x0 0xc1100000 0x0 0x100000>;

			gpio_intc: interrupt-controller@9880 {
				compatible = "amlogic,meson-gpio-intc", "amlogic,meson-gxl-gpio-intc";
				reg = <0x0 0x9880 0x0 0x10>;
				interrupt-controller;
				#interrupt-cells = <0x2>;
				amlogic,channel-interrupts = <0x40 0x41 0x42 0x43 0x44 0x45 0x46 0x47>;
				status = "okay";
			};

			reset: reset-controller@4404 {
				compatible = "amlogic,meson-gxbb-reset";
				reg = <0x0 0x4404 0x0 0x9c>;
				#reset-cells = <0x1>;
			};

			aiu: audio-controller@5400 {
				compatible = "amlogic,aiu-gxl", "amlogic,aiu";
				#sound-dai-cells = <0x2>;
				sound-name-prefix = "AIU";
				reg = <0x0 0x5400 0x0 0x2ac>;
				interrupts = <0x0 0x30 0x1 0x0 0x32 0x1>;
				interrupt-names = "i2s", "spdif";
				status = "okay";
				clocks = <&clkc 0x26 &clkc 0x28 &clkc 0x50 &clkc 0x6b &clkc 0x2c &clkc 0x27 &clkc 0x51 &clkc 0x6e &clkc 0x71>;
				clock-names = "pclk", "i2s_pclk", "i2s_aoclk", "i2s_mclk", "i2s_mixer", "spdif_pclk", "spdif_aoclk", "spdif_mclk", "spdif_mclk_sel";
				resets = <&reset 0x6>;
				pinctrl-0 = <&spdif_out_h_pins>;
				pinctrl-names = "default";
			};

			uart_A: serial@84c0 {
				compatible = "amlogic,meson-gx-uart";
				reg = <0x0 0x84c0 0x0 0x18>;
				interrupts = <0x0 0x1a 0x1>;
				status = "okay";
				fifo-size = <0x80>;
				clocks = <&xtal &clkc 0x1a &xtal>;
				clock-names = "xtal", "pclk", "baud";
				pinctrl-0 = <&uart_a_pins &uart_a_cts_rts_pins>;
				pinctrl-names = "default";

				bluetooth {
					compatible = "brcm,bcm43438-bt";
					shutdown-gpios = <&gpio 0x60 0x0>;
					max-speed = <0x1e8480>;
					clocks = <&wifi32k>;
					clock-names = "lpo";
				};
			};

			uart_B: serial@84dc {
				compatible = "amlogic,meson-gx-uart";
				reg = <0x0 0x84dc 0x0 0x18>;
				interrupts = <0x0 0x4b 0x1>;
				status = "disabled";
				clocks = <&xtal &clkc 0x30 &xtal>;
				clock-names = "xtal", "pclk", "baud";
			};

			i2c_A: i2c@8500 {
				compatible = "amlogic,meson-gxbb-i2c";
				reg = <0x0 0x8500 0x0 0x20>;
				interrupts = <0x0 0x15 0x1>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
				clocks = <&clkc 0x16>;
			};

			pwm_ab: pwm@8550 {
				compatible = "amlogic,meson-gx-pwm", "amlogic,meson-gxbb-pwm";
				reg = <0x0 0x8550 0x0 0x10>;
				#pwm-cells = <0x3>;
				status = "disabled";
			};

			pwm_cd: pwm@8650 {
				compatible = "amlogic,meson-gx-pwm", "amlogic,meson-gxbb-pwm";
				reg = <0x0 0x8650 0x0 0x10>;
				#pwm-cells = <0x3>;
				status = "disabled";
			};

			saradc: adc@8680 {
				compatible = "amlogic,meson-gxm-saradc", "amlogic,meson-saradc";
				reg = <0x0 0x8680 0x0 0x34>;
				#io-channel-cells = <0x1>;
				interrupts = <0x0 0x49 0x1>;
				status = "okay";
				clocks = <&xtal &clkc 0x17 &clkc 0x61 &clkc 0x62>;
				clock-names = "clkin", "core", "adc_clk", "adc_sel";
				vref-supply = <&vddio_ao18>;
			};

			pwm_ef: pwm@86c0 {
				compatible = "amlogic,meson-gx-pwm", "amlogic,meson-gxbb-pwm";
				reg = <0x0 0x86c0 0x0 0x10>;
				#pwm-cells = <0x3>;
				status = "okay";
				pinctrl-0 = <&pwm_e_pins>;
				pinctrl-names = "default";
				clocks = <&clkc 0x6>;
				clock-names = "clkin0";
			};

			uart_C: serial@8700 {
				compatible = "amlogic,meson-gx-uart";
				reg = <0x0 0x8700 0x0 0x18>;
				interrupts = <0x0 0x5d 0x1>;
				status = "disabled";
				clocks = <&xtal &clkc 0x44 &xtal>;
				clock-names = "xtal", "pclk", "baud";
			};

			clock-measure@8758 {
				compatible = "amlogic,meson-gx-clk-measure";
				reg = <0x0 0x8758 0x0 0x10>;
			};

			i2c_B: i2c@87c0 {
				compatible = "amlogic,meson-gxbb-i2c";
				reg = <0x0 0x87c0 0x0 0x20>;
				interrupts = <0x0 0xd6 0x1>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
				clocks = <&clkc 0x16>;
			};

			i2c_C: i2c@87e0 {
				compatible = "amlogic,meson-gxbb-i2c";
				reg = <0x0 0x87e0 0x0 0x20>;
				interrupts = <0x0 0xd7 0x1>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
				clocks = <&clkc 0x16>;
			};

			spicc: spi@8d80 {
				compatible = "amlogic,meson-gx-spicc";
				reg = <0x0 0x8d80 0x0 0x80>;
				interrupts = <0x0 0x51 0x4>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
				clocks = <&clkc 0x15>;
				clock-names = "core";
				resets = <&reset 0xc1>;
				num-cs = <0x1>;
			};

			spifc: spi@8c80 {
				compatible = "amlogic,meson-gxbb-spifc";
				reg = <0x0 0x8c80 0x0 0x80>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
				clocks = <&clkc 0x22>;
			};

			watchdog@98d0 {
				compatible = "amlogic,meson-gxbb-wdt";
				reg = <0x0 0x98d0 0x0 0x10>;
				clocks = <&xtal>;
			};
		};

		gic: interrupt-controller@c4301000 {
			compatible = "arm,gic-400";
			reg = <0x0 0xc4301000 0x0 0x1000 0x0 0xc4302000 0x0 0x2000 0x0 0xc4304000 0x0 0x2000 0x0 0xc4306000 0x0 0x2000>;
			interrupt-controller;
			interrupts = <0x1 0x9 0xff04>;
			#interrupt-cells = <0x3>;
			#address-cells = <0x0>;
		};

		sram: sram@c8000000 {
			compatible = "mmio-sram";
			reg = <0x0 0xc8000000 0x0 0x14000>;
			#address-cells = <0x1>;
			#size-cells = <0x1>;
			ranges = <0x0 0x0 0xc8000000 0x14000>;

			cpu_scp_lpri: scp-sram@0 {
				compatible = "amlogic,meson-gxbb-scp-shmem";
				reg = <0x13000 0x400>;
			};

			cpu_scp_hpri: scp-sram@200 {
				compatible = "amlogic,meson-gxbb-scp-shmem";
				reg = <0x13400 0x400>;
			};
		};

		aobus: bus@c8100000 {
			compatible = "simple-bus";
			reg = <0x0 0xc8100000 0x0 0x100000>;
			#address-cells = <0x2>;
			#size-cells = <0x2>;
			ranges = <0x0 0x0 0x0 0xc8100000 0x0 0x100000>;

			sysctrl_AO: sys-ctrl@0 {
				compatible = "amlogic,meson-gx-ao-sysctrl", "simple-mfd", "syscon";
				reg = <0x0 0x0 0x0 0x100>;

				clkc_AO: clock-controller {
					compatible = "amlogic,meson-gxm-aoclkc", "amlogic,meson-gx-aoclkc";
					#clock-cells = <0x1>;
					#reset-cells = <0x1>;
					clocks = <&xtal &clkc 0xc>;
					clock-names = "xtal", "mpeg-clk";
				};
			};

			vrtc: rtc@a8 {
				compatible = "amlogic,meson-vrtc";
				reg = <0x0 0xa8 0x0 0x4>;
			};

			cec_AO: cec@100 {
				compatible = "amlogic,meson-gx-ao-cec";
				reg = <0x0 0x100 0x0 0x14>;
				interrupts = <0x0 0xc7 0x1>;
				status = "okay";
				clocks = <&clkc_AO 0x6>;
				clock-names = "core";
				pinctrl-0 = <&ao_cec_pins>;
				pinctrl-names = "default";
				hdmi-phandle = <&hdmi_tx>;
			};

			sec_AO: ao-secure@140 {
				compatible = "amlogic,meson-gx-ao-secure", "syscon";
				reg = <0x0 0x140 0x0 0x140>;
				amlogic,has-chip-id;
			};

			uart_AO: serial@4c0 {
				compatible = "amlogic,meson-gx-uart", "amlogic,meson-ao-uart";
				reg = <0x0 0x4c0 0x0 0x18>;
				interrupts = <0x0 0xc1 0x1>;
				status = "okay";
				clocks = <&xtal &clkc_AO 0x3 &xtal>;
				clock-names = "xtal", "pclk", "baud";
				pinctrl-0 = <&uart_ao_a_pins>;
				pinctrl-names = "default";
			};

			uart_AO_B: serial@4e0 {
				compatible = "amlogic,meson-gx-uart", "amlogic,meson-ao-uart";
				reg = <0x0 0x4e0 0x0 0x18>;
				interrupts = <0x0 0xc5 0x1>;
				status = "disabled";
				clocks = <&xtal &clkc_AO 0x4 &xtal>;
				clock-names = "xtal", "pclk", "baud";
			};

			i2c_AO: i2c@500 {
				compatible = "amlogic,meson-gxbb-i2c";
				reg = <0x0 0x500 0x0 0x20>;
				interrupts = <0x0 0xc3 0x1>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
				clocks = <&clkc 0x5d>;
			};

			pwm_AO_ab: pwm@550 {
				compatible = "amlogic,meson-gx-ao-pwm", "amlogic,meson-gxbb-ao-pwm";
				reg = <0x0 0x550 0x0 0x10>;
				#pwm-cells = <0x3>;
				status = "disabled";
			};

			ir: ir@580 {
