diff --git a/drivers/gpu/drm/panfrost/panfrost_diag.h b/drivers/gpu/drm/panfrost/panfrost_diag.h
new file mode 100644
index 00000000..217d719b
--- /dev/null
+++ b/drivers/gpu/drm/panfrost/panfrost_diag.h
@@ -0,0 +1,231 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* B1S diag2: bounded observation only; no PM references or register writes. */
+#ifndef __PANFROST_DIAG_H__
+#define __PANFROST_DIAG_H__
+
+#include <linux/io.h>
+#include <linux/pm_runtime.h>
+
+/* B1S_DIAG2_BEGIN */
+#include <linux/ktime.h>
+#include <linux/sched.h>
+#include <linux/string.h>
+/* B1S_DIAG2_END */
+
+#include "panfrost_device.h"
+#include "panfrost_regs.h"
+
+#define PANFROST_B1S_DIAG_LIMIT 256
+
+static inline int panfrost_diag_take(struct panfrost_device *pfdev)
+{
+	int seq;
+
+	if (!pfdev->b1s_diag_enabled)
+		return 0;
+
+	/* Saturate: a long-running device must never wrap and reopen the budget. */
+	seq = atomic_fetch_add_unless(&pfdev->b1s_diag_seq, 1,
+				    PANFROST_B1S_DIAG_LIMIT + 1);
+	if (seq == PANFROST_B1S_DIAG_LIMIT)
+		dev_info(pfdev->base.dev,
+			 "b1s-diag2: observation limit reached; original diagnostics remain enabled\n");
+
+	return seq < PANFROST_B1S_DIAG_LIMIT ? seq + 1 : 0;
+}
+
+/* No MMIO: safe at callback entry/exit and in the reset worker. */
+#define panfrost_diag_log(pfdev, event, fmt, ...) do { \
+	int __seq = panfrost_diag_take(pfdev); \
+	if (__seq) \
+		dev_info((pfdev)->base.dev, \
+			 "b1s-diag2[%d] %s rpm=%d use=%d bits=%lx " fmt "\n", \
+			 __seq, event, READ_ONCE((pfdev)->base.dev->power.runtime_status), \
+			 atomic_read(&(pfdev)->base.dev->power.usage_count), \
+			 READ_ONCE((pfdev)->is_suspended[0]), ##__VA_ARGS__); \
+} while (0)
+
+/*
+ * Caller must already own an accessible GPU register bank. This helper never
+ * resumes hardware. Do not call after power-off or before resources recover.
+ * The snapshots are not atomic; IRQ/reset activity can interleave with reads.
+ * Avoid fault/error keywords in healthy snapshots: gpu-check checks dmesg.
+ */
+static inline void panfrost_diag_regs(struct panfrost_device *pfdev,
+				     const char *event)
+{
+	int seq = panfrost_diag_take(pfdev);
+	u32 raw, mask, fs, addr_lo, addr_hi, mmu_raw, mmu_mask;
+	u32 shader, tiler, l2, shader_trans, tiler_trans, l2_trans;
+
+	if (!seq)
+		return;
+
+	raw = readl_relaxed(pfdev->iomem + GPU_INT_RAWSTAT);
+	mask = readl_relaxed(pfdev->iomem + GPU_INT_MASK);
+	fs = readl_relaxed(pfdev->iomem + GPU_FAULT_STATUS);
+	addr_lo = readl_relaxed(pfdev->iomem + GPU_FAULT_ADDRESS_LO);
+	addr_hi = readl_relaxed(pfdev->iomem + GPU_FAULT_ADDRESS_HI);
+	mmu_raw = readl_relaxed(pfdev->iomem + MMU_INT_RAWSTAT);
+	mmu_mask = readl_relaxed(pfdev->iomem + MMU_INT_MASK);
+	shader = readl_relaxed(pfdev->iomem + SHADER_READY_LO);
+	tiler = readl_relaxed(pfdev->iomem + TILER_READY_LO);
+	l2 = readl_relaxed(pfdev->iomem + L2_READY_LO);
+	shader_trans = readl_relaxed(pfdev->iomem + SHADER_PWRTRANS_LO);
+	tiler_trans = readl_relaxed(pfdev->iomem + TILER_PWRTRANS_LO);
+	l2_trans = readl_relaxed(pfdev->iomem + L2_PWRTRANS_LO);
+
+	dev_info(pfdev->base.dev,
+		 "b1s-diag2[%d] %s rpm=%d use=%d bits=%lx raw=%08x mask=%08x fs=%08x addr=%08x%08x mmu_raw=%08x mmu_mask=%08x\n",
+		 seq, event, READ_ONCE(pfdev->base.dev->power.runtime_status),
+		 atomic_read(&pfdev->base.dev->power.usage_count),
+		 READ_ONCE(pfdev->is_suspended[0]), raw, mask, fs, addr_hi,
+		 addr_lo, mmu_raw, mmu_mask);
+	dev_info(pfdev->base.dev,
+		 "b1s-diag2[%d] %s ready=%08x/%08x/%08x trans=%08x/%08x/%08x (shader/tiler/l2)\n",
+		 seq, event, shader, tiler, l2, shader_trans, tiler_trans,
+		 l2_trans);
+}
+
+/* B1S_DIAG2_BEGIN */
+/* Fixed RAM storage; only the first resume owner adds MMIO observations. */
+static inline void panfrost_diag2_init(struct panfrost_device *pfdev)
+{
+	memset(&pfdev->b1s_diag2, 0, sizeof(pfdev->b1s_diag2));
+	atomic_set(&pfdev->b1s_diag2.state, 0);
+	atomic_set(&pfdev->b1s_diag2.irq_state, 0);
+}
+
+static inline void panfrost_diag2_begin(struct panfrost_device *pfdev)
+{
+	struct panfrost_b1s_diag2 *d = &pfdev->b1s_diag2;
+
+	if (!pfdev->b1s_diag_enabled ||
+	    atomic_read(&pfdev->b1s_diag_seq) >= PANFROST_B1S_DIAG_LIMIT ||
+	    atomic_cmpxchg(&d->state, 0, 1))
+		return;
+
+	WRITE_ONCE(d->owner, current);
+	d->begin_ns = ktime_get_mono_fast_ns();
+}
+
+static inline bool panfrost_diag2_owned(struct panfrost_device *pfdev)
+{
+	struct panfrost_b1s_diag2 *d = &pfdev->b1s_diag2;
+
+	if (!pfdev->b1s_diag_enabled || READ_ONCE(d->owner) != current)
+		return false;
+
+	return atomic_read(&d->state) == 1;
+}
+
+/* Caller has the same accessible register domain as the original power_on. */
+static inline void panfrost_diag2_record(struct panfrost_device *pfdev,
+					 u32 phase, bool polled, u32 target,
+					 u32 val, int rc)
+{
+	struct panfrost_b1s_diag2 *d = &pfdev->b1s_diag2;
+	struct panfrost_b1s_diag2_sample *s;
+
+	if (!panfrost_diag2_owned(pfdev) || phase == B1S_D2_NONE ||
+	    phase >= B1S_D2_PHASES ||
+	    atomic_read(&pfdev->b1s_diag_seq) >= PANFROST_B1S_DIAG_LIMIT)
+		return;
+
+	s = &d->sample[phase];
+	if (s->present)
+		return;
+
+	/* Software boundary, not a hardware completion or a causal assertion. */
+	WRITE_ONCE(d->phase, phase);
+	s->begin_ns = ktime_get_mono_fast_ns();
+	s->raw = readl_relaxed(pfdev->iomem + GPU_INT_RAWSTAT);
+	s->fs = readl_relaxed(pfdev->iomem + GPU_FAULT_STATUS);
+	s->end_ns = ktime_get_mono_fast_ns();
+	s->target = target;
+	s->val = val;
+	s->rc = rc;
+	s->polled = polled;
+	s->present = true;
+}
+
+static inline void panfrost_diag2_mark(struct panfrost_device *pfdev, u32 phase)
+{
+	panfrost_diag2_record(pfdev, phase, false, 0, 0, 0);
+}
+
+static inline void panfrost_diag2_polled(struct panfrost_device *pfdev,
+					 u32 phase, u32 target, u32 val, int rc)
+{
+	panfrost_diag2_record(pfdev, phase, true, target, val, rc);
+}
+
+/* Reuse original IRQ values, before its potentially lengthy exception WARN. */
+static inline void panfrost_diag2_irq(struct panfrost_device *pfdev,
+				      u32 state, u32 fs, u64 addr)
+{
+	struct panfrost_b1s_diag2 *d = &pfdev->b1s_diag2;
+
+	if (!pfdev->b1s_diag_enabled || atomic_read(&d->state) != 1 ||
+	    atomic_cmpxchg(&d->irq_state, 0, 1))
+		return;
+
+	d->irq.ns = ktime_get_mono_fast_ns();
+	d->irq.phase = READ_ONCE(d->phase);
+	d->irq.state = state;
+	d->irq.fs = fs;
+	d->irq.addr = addr;
+	atomic_set_release(&d->irq_state, 2);
+}
+
+/* RAM-only, including every error exit after resources may become unavailable. */
+static inline void panfrost_diag2_end(struct panfrost_device *pfdev, int rc)
+{
+	static const char * const names[B1S_D2_PHASES] = {
+		"none", "generic.before", "generic.after", "vendor.before",
+		"vendor.after", "l2.before", "l2.written", "l2.polled",
+		"shader.before", "shader.written", "shader.polled",
+		"tiler.before", "tiler.written", "tiler.polled"
+	};
+	struct panfrost_b1s_diag2 *d = &pfdev->b1s_diag2;
+	u64 end_ns;
+	unsigned int i, count = 0;
+	int irq_state;
+
+	if (!panfrost_diag2_owned(pfdev))
+		return;
+
+	end_ns = ktime_get_mono_fast_ns();
+	atomic_set(&d->state, 2);
+	WRITE_ONCE(d->owner, NULL);
+	irq_state = atomic_read_acquire(&d->irq_state);
+	for (i = 1; i < B1S_D2_PHASES; i++)
+		count += d->sample[i].present;
+
+	panfrost_diag_log(pfdev, "boundary.begin",
+			  "samples=%u irq_state=%d ns=%llu/%llu rc=%d vendor=%d",
+			  count, irq_state, d->begin_ns, end_ns, rc,
+			  !!pfdev->comp->vendor_quirk);
+	for (i = 1; i < B1S_D2_PHASES; i++) {
+		const struct panfrost_b1s_diag2_sample *s = &d->sample[i];
+
+		if (!s->present)
+			continue;
+		panfrost_diag_log(pfdev, "boundary.sample",
+				  "phase=%u name=%s ns=%llu/%llu raw=%08x fs=%08x poll=%d target=%08x val=%08x rc=%d",
+				  i, names[i], s->begin_ns, s->end_ns, s->raw,
+				  s->fs, s->polled, s->target, s->val, s->rc);
+	}
+	/* A writer in state 1 may still publish: do not wait or copy partial data. */
+	if (irq_state == 2)
+		panfrost_diag_log(pfdev, "boundary.irq",
+				  "ns=%llu phase=%u state=%08x fs=%08x addr=%016llx",
+				  d->irq.ns, d->irq.phase, d->irq.state,
+				  d->irq.fs, d->irq.addr);
+	panfrost_diag_log(pfdev, "boundary.end", "samples=%u irq_state=%d",
+			  count, irq_state);
+}
+
+/* B1S_DIAG2_END */
+
+#endif
