+			panfrost_diag2_end(pfdev, ret);
+			panfrost_b1s_rt_log(pfdev, "b1s-rtb1.resume-ext", &trace);
 			return ret;
+		}
 
 		ret = clk_enable(pfdev->clock);
+		trace.calls |= B1S_RT_CLOCK_ENABLE;
+		trace.clock_rc = ret;
